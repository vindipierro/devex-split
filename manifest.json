{
  "manifest_version": 3,
  "name": "Roblox DevEx Rate Split",
  "version": "1.0.0",
  "description": "Shows how eligible DevEx Robux split between two exchange rates.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://create.roblox.com/dashboard/devex*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
